# shellcheck disable=SC2034

# Available options:
#     - home (Linux desktop)
#     - laptop (MacOS laptop)
#     - work (MacOS laptop)
DEVSPACE=home

# Optional mobile notifications for the local OpenCode ntfy plugin. Keep real
# values in .env, which is ignored by Git; the plugin is inactive without a topic.
# OPENCODE_NTFY_URL=https://ntfy.sh
# OPENCODE_NTFY_TOPIC=your-private-topic
# OPENCODE_NTFY_TOKEN=your-ntfy-access-token

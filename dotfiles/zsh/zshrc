. ~/.zsh_helpers

# Environment is refreshed on every source; integration guards below are not
# exported, so each nested shell still installs its own functions and hooks.
if_debug path_print '$PATH before zshrc'

if [[ -r /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]]; then
    source /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
fi

[[ -x "$HOME/.env_bootstrap" ]] && "$HOME/.env_bootstrap"

export LANG=en_US.UTF-8
export EDITOR=nvim
export XDG_CONFIG_HOME="$HOME/.config"
export ZSH="$HOME/.oh-my-zsh"
export NVM_DIR="$HOME/.nvm"
export OPENCODE_EXPERIMENTAL_LSP_TOOL=true
export OPENCODE_ENABLE_EXA=true

if [[ "$OSTYPE" == darwin* ]]; then
    export PNPM_HOME="$HOME/Library/pnpm"
else
    export PNPM_HOME="$HOME/.local/share/pnpm"
fi

[[ -f "$HOME/.config/home-manager/.env" ]] && \
    load_shell_env "$HOME/.config/home-manager/.env"

if [[ -t 0 ]]; then
    export GPG_TTY="$(tty)"
else
    unset GPG_TTY
fi

if [[ "$OSTYPE" == darwin* ]]; then
    # Prefer Apple clang for sources that include macOS framework headers.
    export CC=/usr/bin/clang
    export CXX=/usr/bin/clang++
    if [[ "$DEVSPACE" == work && -x /usr/libexec/java_home ]]; then
        if _java_home=$(/usr/libexec/java_home 2>/dev/null); then
            export JAVA_HOME="$_java_home"
        fi
        unset _java_home
    fi
fi

# Initialize Apple Silicon Homebrew without relying on the inherited PATH.
if [[ "$OSTYPE" == darwin* && -z "${_shell_homebrew_initialized-}" && -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
    typeset -g _shell_homebrew_initialized=1
fi

# NVM installs shell functions, so its guard must not be inherited by children.
if [[ -z "${_shell_nvm_initialized-}" && -s "$NVM_DIR/nvm.sh" ]]; then
    source "$NVM_DIR/nvm.sh"
    typeset -g _shell_nvm_initialized=1
fi

# Keep MANPATH entries unique.
typeset -gUT MANPATH manpath
manpath=(/usr/local/man "${manpath[@]}")
# An empty component tells man to include its default search paths.
[[ ":$MANPATH:" == *::* ]] || manpath+=("")
export MANPATH

# Prepend in reverse priority order. ~/.local/bin must precede Nix for the
# bootstrap's Apple cc wrapper; user-installed tools take priority over both.
path_prepend /usr/bin
[[ -n "${HOMEBREW_PREFIX-}" ]] && path_prepend "$HOMEBREW_PREFIX/opt/openjdk/bin"
path_prepend "$HOME/.swiftly/bin"
path_prepend "$HOME/.cargo/bin"
path_prepend "$HOME/.nix-profile/bin"
path_prepend "$HOME/.local/bin"
path_prepend "$HOME/bin"
path_prepend "$PNPM_HOME"
# Preserve the selected Node version when refreshing the environment.
path_prepend "${NVM_BIN-}"
path_append "$HOME/.local/share/nvim/mason/bin"
path_append "$HOME/go/bin"
path_append "$HOME/bin/flutter/bin"
path_append "$HOME/Node/bin"
if [[ "$OSTYPE" == darwin* ]]; then
    path_append "$HOME/Library/Android/sdk/platform-tools"
    path_append "/Applications/Visual Studio Code.app/Contents/Resources/app/bin"
fi
export PATH

if_debug path_print '$PATH after zshrc'

[[ -n "${_shell_interactive_initialized-}" ]] && return 0

zstyle ':omz:update' auto
zstyle ':omz:update' frequency 10

COMPLETION_WAITING_DOTS="true"
HIST_STAMPS="dd/mm/yyyy"

plugins=(
    aws
    colored-man-pages
    command-not-found
    copyfile
    docker
    docker-compose
    gh
    git
    gitfast
    golang
    kubectl
    rust
    ssh
    sudo
    terraform
    timer
)

# Add generated completions before Oh My Zsh runs compinit.
ensure_zsh_completion just --completions zsh
ensure_zsh_completion opencode --completions zsh
ensure_zsh_completion ovhcloud
fpath+=("$HOME/.zsh/completions")

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
    source "$ZSH/oh-my-zsh.sh"
else
    autoload -Uz compinit && compinit
fi

# Plugins Config
TIMER_FORMAT='[%d]'

# Zsh Config
bindkey -v

# Aliases
## Docker Compose
alias dc='docker compose'
alias dcu='docker compose up'
alias dcud='docker compose up -d'
alias dcd='docker compose down'
alias dcdv='docker compose down -v'
alias dcl='docker compose logs'
alias dclf='docker compose logs -f'
alias dce='docker compose exec'
alias dcr='docker compose run'

## Lazygit
alias lg='lazygit'

## Nvim
alias v='nvim'
alias vi='nvim'
alias vim='nvim'

## OpenCode
alias oc='opencode'

## Pnpm
alias p='pnpm'
alias pi='pnpm install'
alias px='pnpx'

## Terraform
alias tf='terraform'
alias tfi='terraform init'
alias tfp='terraform plan'
alias tfa='terraform apply'

## Tmux
alias t='tmux'
alias ta='tmux attach'

alias tenpu='just'

# Starship Prompt
if (( $+commands[starship] )); then
    eval "$(starship init zsh)"
fi

typeset -g _shell_interactive_initialized=1

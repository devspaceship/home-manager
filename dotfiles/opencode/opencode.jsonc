{
	"$schema": "https://opencode.ai/config.json",
	"default_agent": "plan",
	"autoupdate": true,
	"enabled_providers": ["github-copilot", "opencode", "ollama", "openai"],
	"provider": {
		"ollama": {
			"models": {
				"deepseek-coder:6.7b": {
					"name": "Deepseek Coder 6.7b"
				},
				"deepseek-coder:33b": {
					"name": "Deepseek Coder 33b"
				},
				"qwen3.5:9b": {
					"name": "Qwen3.5 9b"
				},
				"qwen3.5:27b": {
					"name": "Qwen3.5 27b"
				}
			},
			"name": "Ollama",
			"npm": "@ai-sdk/openai-compatible",
			"options": {
				"baseURL": "http://127.0.0.1:11434/v1"
			}
		}
	},
	"mcp": {
		"linear": {
			"type": "remote",
			"url": "https://mcp.linear.app/mcp"
		},
		"sentry": {
			"type": "remote",
			"url": "https://mcp.sentry.dev/mcp",
			"oauth": {}
		}
	},
	"permission": {
		"*": "ask",
		"bash": {
			"*": "ask",
			"cargo add *": "allow",
			"cargo build *": "allow",
			"cargo init *": "allow",
			"cargo run *": "allow",
			"cat *": "allow",
			"cp *": "allow",
			"curl *": "allow",
			"docker ls*": "allow",
			"docker compose ls*": "allow",
			"docker ps*": "allow",
			"docker compose ps*": "allow",
			"echo *": "allow",
			"file *": "allow",
			"find *": "allow",
			"gh api /repos/*/dependabot/alerts*": "allow",
			"gh api repos/*/dependabot/alerts*": "allow",
			"gh auth status*": "allow",
			"gh pr status *": "allow",
			"git branch *": "allow",
			"git config --list *": "allow",
			"git diff *": "allow",
			"git grep *": "allow",
			"git log*": "allow",
			"git ls-files*": "allow",
			"git ls-tree *": "allow",
			"git remote get-url *": "allow",
			"git rev-parse *": "allow",
			"git show *": "allow",
			"git status *": "allow",
			"grep *": "allow",
			"head *": "allow",
			"jq *": "allow",
			"kubectl cluster-info*": "allow",
			"kubectl describe *": "allow",
			"kubectl get *": "allow",
			"kubectl logs *": "allow",
			"kubectl top *": "allow",
			"ls *": "allow",
			"mkdir *": "allow",
			"npm view *": "allow",
			"pnpm why *": "allow",
			"rg *": "allow",
			"sed *": "allow",
			"sleep *": "allow",
			"sort *": "allow",
			"tail *": "allow",
			"tree *": "allow",
			"trunk *": "allow",
			"wc *": "allow",
			"which *": "allow"
		},
		"read": {
			"*": "allow",
			"*.env": "deny",
			"*.env.*": "deny",
			"*.env.example": "allow"
		},
		"edit": "allow",
		"glob": "allow",
		"grep": "allow",
		"list": "allow",
		"task": "allow",
		"skill": "allow",
		"lsp": "allow",
		"todoread": "allow",
		"todowrite": "allow",
		"webfetch": "allow",
		"websearch": "allow",
		"question": "allow",
		"codesearch": "allow",
		"external_directory": {
			"*": "ask",
			"~/code": "allow",
			"~/.config/home-manager": "allow",
			"~/.local/share/nvim": "allow"
		},
		// Linear MCP
		"linear_get_project": "allow",
		"linear_get_issue": "allow",
		"linear_get_diff": "allow",
		"linear_get_diff_threads": "allow",
		"linear_list_teams": "allow",
		"linear_list_projects": "allow",
		"linear_list_project_labels": "allow",
		"linear_list_issues": "allow",
		"linear_list_issue_statuses": "allow",
		"linear_list_issue_labels": "allow",
		"linear_list_comments": "allow",
		"linear_list_diffs": "allow",
		"linear_search_documentation": "allow"
	}
}

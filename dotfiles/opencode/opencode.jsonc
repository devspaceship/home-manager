{
	"$schema": "https://opencode.ai/config.json",
	"default_agent": "plan",
	"update": "auto",
	"lsp": true,
	"formatter": true,
	"experimental": {
		"todo": true
	},
	"policies": [
		{ "action": "provider.use", "resource": "*", "effect": "deny" },
		{
			"action": "provider.use",
			"resource": "github-copilot",
			"effect": "allow"
		},
		{ "action": "provider.use", "resource": "opencode", "effect": "allow" },
		{ "action": "provider.use", "resource": "ollama", "effect": "allow" },
		{ "action": "provider.use", "resource": "openai", "effect": "allow" }
	],
	"providers": {
		"ollama": {
			"models": {
				"deepseek-coder:6.7b": {
					"name": "Deepseek Coder 6.7b"
				},
				"deepseek-coder:33b": {
					"name": "Deepseek Coder 33b"
				},
				"qwen3.5:9b": {
					"name": "Qwen3.5 9b"
				},
				"qwen3.5:27b": {
					"name": "Qwen3.5 27b"
				}
			},
			"name": "Ollama",
			"package": "aisdk:@ai-sdk/openai-compatible",
			"settings": {
				"baseURL": "http://127.0.0.1:11434/v1"
			}
		}
	},
	"mcp": {
		"servers": {
			"figma": {
				"type": "remote",
				"url": "https://mcp.figma.com/mcp",
				"oauth": {
					"client_id": "{file:~/.local/share/opencode/figma-oauth/client-id.txt}",
					"client_secret": "{file:~/.local/share/opencode/figma-oauth/client-secret.txt}"
				}
			},
			"linear": {
				"type": "remote",
				"url": "https://mcp.linear.app/mcp"
			},
			"notion": {
				"type": "remote",
				"url": "https://mcp.notion.com/mcp"
			},
			"sentry": {
				"type": "remote",
				"url": "https://mcp.sentry.dev/mcp",
				"oauth": {}
			}
		}
	},
	"permissions": [
		{ "action": "*", "resource": "*", "effect": "ask" },
		{ "action": "shell", "resource": "*", "effect": "ask" },
		// Broad execution, network access, and mutations retain the default ask.
		// Shell inspection is not a sandbox and can bypass tool-level file rules.
		{ "action": "shell", "resource": "cat *", "effect": "allow" },
		{ "action": "shell", "resource": "docker ls*", "effect": "allow" },
		{ "action": "shell", "resource": "docker compose ls*", "effect": "allow" },
		{ "action": "shell", "resource": "docker ps*", "effect": "allow" },
		{ "action": "shell", "resource": "docker compose ps*", "effect": "allow" },
		{ "action": "shell", "resource": "echo *", "effect": "allow" },
		{ "action": "shell", "resource": "file *", "effect": "allow" },
		{ "action": "shell", "resource": "gh auth status*", "effect": "allow" },
		{ "action": "shell", "resource": "gh pr list *", "effect": "allow" },
		{ "action": "shell", "resource": "gh pr status *", "effect": "allow" },
		{ "action": "shell", "resource": "gh pr view *", "effect": "allow" },
		{ "action": "shell", "resource": "git config --list *", "effect": "allow" },
		{ "action": "shell", "resource": "git diff *", "effect": "allow" },
		{ "action": "shell", "resource": "git grep *", "effect": "allow" },
		{ "action": "shell", "resource": "git log*", "effect": "allow" },
		{ "action": "shell", "resource": "git ls-files*", "effect": "allow" },
		{ "action": "shell", "resource": "git ls-tree *", "effect": "allow" },
		{
			"action": "shell",
			"resource": "git remote get-url *",
			"effect": "allow"
		},
		{ "action": "shell", "resource": "git remote -v *", "effect": "allow" },
		{ "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
		{ "action": "shell", "resource": "git show *", "effect": "allow" },
		{ "action": "shell", "resource": "git status *", "effect": "allow" },
		{ "action": "shell", "resource": "grep *", "effect": "allow" },
		{ "action": "shell", "resource": "head *", "effect": "allow" },
		{ "action": "shell", "resource": "helm lint *", "effect": "allow" },
		{ "action": "shell", "resource": "helm template *", "effect": "allow" },
		{ "action": "shell", "resource": "jq *", "effect": "allow" },
		{
			"action": "shell",
			"resource": "kubectl cluster-info*",
			"effect": "allow"
		},
		{ "action": "shell", "resource": "kubectl describe *", "effect": "allow" },
		{ "action": "shell", "resource": "kubectl get *", "effect": "allow" },
		{ "action": "shell", "resource": "kubectl logs *", "effect": "allow" },
		{ "action": "shell", "resource": "kubectl top *", "effect": "allow" },
		{ "action": "shell", "resource": "ls *", "effect": "allow" },
		{ "action": "shell", "resource": "mkdir *", "effect": "allow" },
		{ "action": "shell", "resource": "npm view *", "effect": "allow" },
		{ "action": "shell", "resource": "pnpm why *", "effect": "allow" },
		{
			"action": "shell",
			"resource": "pnpm exec biome check *",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "pnpm exec biome check *--write*",
			"effect": "ask"
		},
		{
			"action": "shell",
			"resource": "pnpm exec biome check *--fix*",
			"effect": "ask"
		},
		{
			"action": "shell",
			"resource": "pnpm exec commitlint *",
			"effect": "allow"
		},
		{ "action": "shell", "resource": "pnpm exec vitest *", "effect": "allow" },
		{ "action": "shell", "resource": "rg *", "effect": "allow" },
		{ "action": "shell", "resource": "sleep *", "effect": "allow" },
		{ "action": "shell", "resource": "sort *", "effect": "allow" },
		{ "action": "shell", "resource": "tail *", "effect": "allow" },
		{ "action": "shell", "resource": "tree *", "effect": "allow" },
		{ "action": "shell", "resource": "wc *", "effect": "allow" },
		{ "action": "shell", "resource": "which *", "effect": "allow" },
		{ "action": "read", "resource": "*", "effect": "allow" },
		{ "action": "read", "resource": "*.env", "effect": "deny" },
		{ "action": "read", "resource": "*.env.*", "effect": "deny" },
		{ "action": "read", "resource": "**/.npmrc", "effect": "deny" },
		{ "action": "read", "resource": "**/.ssh/**", "effect": "deny" },
		{ "action": "read", "resource": "**/id_ecdsa", "effect": "deny" },
		{ "action": "read", "resource": "**/id_ed25519", "effect": "deny" },
		{ "action": "read", "resource": "**/id_rsa", "effect": "deny" },
		{ "action": "read", "resource": "**/secrets/**", "effect": "deny" },
		{ "action": "read", "resource": "**/*.key", "effect": "deny" },
		{ "action": "read", "resource": "**/*.p12", "effect": "deny" },
		{ "action": "read", "resource": "**/*.pfx", "effect": "deny" },
		{ "action": "read", "resource": "**/*.pem", "effect": "deny" },
		{ "action": "read", "resource": "*.env.example", "effect": "allow" },
		{ "action": "edit", "resource": "*", "effect": "allow" },
		{ "action": "edit", "resource": "*.env", "effect": "deny" },
		{ "action": "edit", "resource": "*.env.*", "effect": "deny" },
		{ "action": "edit", "resource": "**/.npmrc", "effect": "deny" },
		{ "action": "edit", "resource": "**/.ssh/**", "effect": "deny" },
		{ "action": "edit", "resource": "**/id_ecdsa", "effect": "deny" },
		{ "action": "edit", "resource": "**/id_ed25519", "effect": "deny" },
		{ "action": "edit", "resource": "**/id_rsa", "effect": "deny" },
		{ "action": "edit", "resource": "**/secrets/**", "effect": "deny" },
		{ "action": "edit", "resource": "**/*.key", "effect": "deny" },
		{ "action": "edit", "resource": "**/*.p12", "effect": "deny" },
		{ "action": "edit", "resource": "**/*.pfx", "effect": "deny" },
		{ "action": "edit", "resource": "**/*.pem", "effect": "deny" },
		{ "action": "edit", "resource": "*.env.example", "effect": "allow" },
		{ "action": "glob", "resource": "*", "effect": "allow" },
		{ "action": "grep", "resource": "*", "effect": "allow" },
		{ "action": "list", "resource": "*", "effect": "allow" },
		{ "action": "subagent", "resource": "*", "effect": "allow" },
		{ "action": "skill", "resource": "*", "effect": "allow" },
		{ "action": "lsp", "resource": "*", "effect": "allow" },
		{ "action": "todoread", "resource": "*", "effect": "allow" },
		{ "action": "todowrite", "resource": "*", "effect": "allow" },
		{ "action": "webfetch", "resource": "*", "effect": "allow" },
		{ "action": "websearch", "resource": "*", "effect": "allow" },
		{ "action": "question", "resource": "*", "effect": "allow" },
		{ "action": "codesearch", "resource": "*", "effect": "allow" },
		{ "action": "external_directory", "resource": "*", "effect": "ask" },
		{ "action": "external_directory", "resource": "~/code", "effect": "allow" },
		{
			"action": "external_directory",
			"resource": "~/code/**",
			"effect": "allow"
		},
		{
			"action": "external_directory",
			"resource": "~/.config/home-manager",
			"effect": "allow"
		},
		{
			"action": "external_directory",
			"resource": "~/.local/share/nvim",
			"effect": "allow"
		},
		// Linear MCP
		{ "action": "linear_get_workspace", "resource": "*", "effect": "allow" },
		{ "action": "linear_get_project", "resource": "*", "effect": "allow" },
		{ "action": "linear_get_issue", "resource": "*", "effect": "allow" },
		{ "action": "linear_get_diff", "resource": "*", "effect": "allow" },
		{ "action": "linear_get_diff_threads", "resource": "*", "effect": "allow" },
		{ "action": "linear_list_teams", "resource": "*", "effect": "allow" },
		{ "action": "linear_list_projects", "resource": "*", "effect": "allow" },
		{
			"action": "linear_list_project_labels",
			"resource": "*",
			"effect": "allow"
		},
		{ "action": "linear_list_issues", "resource": "*", "effect": "allow" },
		{
			"action": "linear_list_issue_statuses",
			"resource": "*",
			"effect": "allow"
		},
		{
			"action": "linear_list_issue_labels",
			"resource": "*",
			"effect": "allow"
		},
		{ "action": "linear_list_templates", "resource": "*", "effect": "allow" },
		{ "action": "linear_list_comments", "resource": "*", "effect": "allow" },
		{ "action": "linear_list_documents", "resource": "*", "effect": "allow" },
		{ "action": "linear_list_diffs", "resource": "*", "effect": "allow" },
		{ "action": "linear_list_users", "resource": "*", "effect": "allow" },
		{ "action": "linear_save_issue", "resource": "*", "effect": "ask" },
		{
			"action": "linear_search_documentation",
			"resource": "*",
			"effect": "allow"
		},
		{ "action": "notion_notion_fetch", "resource": "*", "effect": "allow" },
		{ "action": "notion_notion_search", "resource": "*", "effect": "allow" }
	]
}

{
	"$schema": "https://opencode.ai/v2/cli.json",
	"theme": {
		"name": "catppuccin"
	},
	"scroll": {
		"speed": 3,
		"acceleration": true
	},
	"diffs": {
		"view": "auto"
	},
	"cursor": {
		"style": "block",
		"blinking": true
	},
	"mouse": true,
	"tabs": {
		"mode": "off"
	},
	"attention": {
		"notifications": true,
		"sound": true,
		"volume": 0.95
	}
}
